# Supabase PostgreSQL (server key must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public application address and 32+ character secret for encrypting TOTP keys
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters
REQUIRE_EMAIL_VERIFICATION=true

# Resend transactional email
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=ShadowNode <security@example.com>

# OAuth callback URLs are /api/auth/oauth/{google|microsoft|github}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
